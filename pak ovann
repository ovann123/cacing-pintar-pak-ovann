<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Cacing Pintar Pak Ovan - Game Edukasi Informatika SMP</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Google Fonts Inter & Fredoka -->
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            fredoka: ['Fredoka', 'sans-serif'],
            sans: ['Inter', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <style>
    * {
      user-select: none;
      -webkit-user-select: none;
      touch-action: manipulation;
    }
    body {
      font-family: 'Fredoka', sans-serif;
      overflow: hidden;
      background-color: #0f172a;
    }
    canvas {
      display: block;
      background: #020617;
    }
    .glass {
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .glass-card {
      background: rgba(30, 41, 59, 0.7);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    #joystickZone {
      position: absolute;
      bottom: 25px;
      left: 25px;
      width: 120px;
      height: 120px;
      background: rgba(255, 255, 255, 0.12);
      border: 2px solid rgba(255, 255, 255, 0.25);
      border-radius: 50%;
      touch-action: none;
      z-index: 30;
    }
    #joystickKnob {
      position: absolute;
      top: 35px;
      left: 35px;
      width: 50px;
      height: 50px;
      background: radial-gradient(circle, #38bdf8 0%, #0284c7 100%);
      border-radius: 50%;
      box-shadow: 0 0 15px rgba(56, 189, 248, 0.6);
      pointer-events: none;
    }
    @keyframes pulseGlow {
      0%, 100% { opacity: 0.8; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.03); }
    }
    .animate-glow {
      animation: pulseGlow 2s infinite ease-in-out;
    }
  </style>

  <!-- Early Global Setup to prevent ReferenceError -->
  <script>
    window.joinGameAsStudent = function() {};
    window.togglePauseGame = function() {};
    window.resumeGameFromPause = function() {};
    window.restartGame = function() {};
  </script>
</head>
<body class="text-white h-screen w-screen relative select-none">

  <!-- ========================================== -->
  <!-- LOBBY & PLAYER REGISTRATION SCREEN         -->
  <!-- ========================================== -->
  <div id="lobbyScreen" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/90 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-900 via-slate-950 to-black overflow-y-auto">
    <div class="max-w-md w-full glass rounded-3xl p-6 md:p-8 shadow-2xl relative border border-slate-800 my-auto text-center">
      
      <!-- Header -->
      <div class="mb-6">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-tr from-cyan-500 to-blue-600 shadow-lg shadow-cyan-500/30 mb-3 animate-glow">
          <span class="text-3xl">🐛</span>
        </div>
        <h1 class="text-3xl font-extrabold tracking-wide bg-gradient-to-r from-cyan-400 via-sky-300 to-indigo-400 bg-clip-text text-transparent">
          CACING PINTAR
        </h1>
        <p class="text-xs text-slate-400 font-sans mt-1">
          Game Edukasi Informatika SMP - <span class="text-sky-400 font-semibold">Pak Ovan</span>
        </p>
      </div>

      <!-- Toast Alert -->
      <div id="toastAlert" class="hidden mb-4 p-3 rounded-xl bg-rose-500/20 border border-rose-500/40 text-rose-300 text-xs font-semibold text-center animate-bounce"></div>

      <!-- Student Form -->
      <div class="space-y-4 text-left">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5 uppercase tracking-wider">Nama Lengkap / Nomor Absen</label>
          <div class="relative">
            <i class="fa-solid fa-user absolute left-4 top-3.5 text-slate-400"></i>
            <input type="text" id="inputStudentName" placeholder="Contoh: 05 - Budi Santoso" class="w-full bg-slate-900/90 border border-slate-700 rounded-xl px-4 py-3 pl-11 text-white font-sans focus:outline-none focus:ring-2 focus:ring-sky-500">
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5 uppercase tracking-wider">Pilih Warna Cacing</label>
          <div class="grid grid-cols-6 gap-2" id="colorPickerContainer">
            <!-- Dynamic color choices -->
          </div>
        </div>

        <button onclick="window.joinGameAsStudent()" class="w-full py-4 bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white font-bold text-lg rounded-2xl shadow-lg shadow-emerald-500/25 active:scale-[0.98] transition-all flex items-center justify-center gap-2 mt-4">
          <i class="fa-solid fa-play"></i> MULAI PERMAINAN
        </button>
      </div>

    </div>
  </div>

  <!-- ========================================== -->
  <!-- PAUSE MENU OVERLAY                         -->
  <!-- ========================================== -->
  <div id="pauseModal" class="fixed inset-0 z-40 bg-slate-950/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="max-w-xs w-full glass rounded-3xl p-6 text-center border border-sky-500/30 shadow-2xl space-y-4">
      <div class="w-16 h-16 rounded-full bg-amber-500/20 border-2 border-amber-400 text-amber-400 flex items-center justify-center text-2xl mx-auto">
        <i class="fa-solid fa-pause"></i>
      </div>
      <h2 class="text-2xl font-bold text-white">GAME DI-PAUSE</h2>
      <p class="text-xs text-slate-300 font-sans">
        Permainan dihentikan sementara. Tekan tombol di bawah untuk melanjutkan.
      </p>
      
      <div class="space-y-2 pt-2">
        <button onclick="window.resumeGameFromPause()" class="w-full py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl shadow-lg shadow-emerald-600/30 transition-all flex items-center justify-center gap-2">
          <i class="fa-solid fa-play"></i> LANJUTKAN
        </button>
        <button onclick="window.restartGame()" class="w-full py-3 bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold rounded-xl transition-all flex items-center justify-center gap-2 text-xs">
          <i class="fa-solid fa-rotate-right"></i> MAIN ULANG
        </button>
      </div>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- GAME CANVAS HUD OVERLAY                    -->
  <!-- ========================================== -->
  <div id="gameHUD" class="fixed inset-0 pointer-events-none z-20 flex flex-col justify-between p-4 hidden">
    <!-- Top Bar -->
    <div class="flex justify-between items-start">
      <!-- Player Info & Score -->
      <div class="glass p-3 rounded-2xl pointer-events-auto flex items-center gap-3">
        <div id="hudWormPreview" class="w-8 h-8 rounded-full border-2 border-white/50 shadow-inner flex items-center justify-center text-xs">👀</div>
        <div>
          <div id="hudPlayerName" class="font-bold text-sm text-slate-100 max-w-[120px] truncate">Pemain</div>
          <div class="text-xs text-sky-400 font-mono font-bold">Skor: <span id="hudScore">0</span></div>
        </div>
      </div>

      <!-- Action Pause & Stats Buttons -->
      <div class="flex items-center gap-2 pointer-events-auto">
        <button onclick="window.togglePauseGame()" id="btnPauseHUD" class="glass px-4 py-2.5 rounded-2xl text-amber-400 hover:text-amber-300 font-bold text-xs flex items-center gap-2 border border-amber-500/30 transition-all">
          <i class="fa-solid fa-pause"></i> <span>PAUSE</span>
        </button>
      </div>

      <!-- Mini Leaderboard / Stats -->
      <div class="glass p-3 rounded-2xl pointer-events-auto hidden md:block w-48 font-sans">
        <div class="text-[10px] font-bold text-slate-400 uppercase mb-1 flex items-center justify-between">
          <span>Statistik Saya</span>
          <i class="fa-solid fa-chart-simple text-sky-400"></i>
        </div>
        <div class="text-xs space-y-1">
          <div class="flex justify-between text-emerald-400 font-semibold">
            <span>Benar:</span> <span id="statCorrect">0</span>
          </div>
          <div class="flex justify-between text-rose-400 font-semibold">
            <span>Salah:</span> <span id="statWrong">0</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Virtual Joystick (Mobile) -->
    <div id="joystickZone" class="pointer-events-auto md:hidden">
      <div id="joystickKnob"></div>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- INFORMATICS QUIZ POPUP MODAL               -->
  <!-- ========================================== -->
  <div id="quizModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden flex items-center justify-center p-4">
    <div class="max-w-md w-full glass rounded-3xl p-6 border border-sky-500/30 shadow-2xl relative">
      <div class="flex justify-between items-center mb-4">
        <span class="px-3 py-1 bg-sky-500/20 text-sky-400 text-xs font-bold rounded-full border border-sky-500/30">
          <i class="fa-solid fa-brain mr-1"></i> Soal Informatika SMP
        </span>
        <span id="quizCategory" class="text-[11px] text-slate-400 font-sans">Hardware & Software</span>
      </div>

      <!-- Question Text -->
      <h3 id="quizQuestionText" class="text-base md:text-lg font-bold text-slate-100 mb-6 leading-relaxed">
        Pertanyaan akan muncul di sini...
      </h3>

      <!-- Answer Options -->
      <div id="quizOptionsContainer" class="space-y-2.5 font-sans">
        <!-- Dynamic Options -->
      </div>

      <!-- Feedback Banner -->
      <div id="quizFeedback" class="mt-4 p-3 rounded-xl text-center text-xs font-bold hidden"></div>
    </div>
  </div>

  <!-- MAIN GAME CANVAS -->
  <canvas id="gameCanvas"></canvas>

  <!-- ========================================== -->
  <!-- JAVASCRIPT LOGIC                           -->
  <!-- ========================================== -->
  <script type="module">
    // State Application
    const state = {
      studentName: '',
      color: "#ef4444",
      score: 0,
      correctCount: 0,
      wrongCount: 0,
      gameRunning: false,
      isUserPaused: false,
      isPausedForQuiz: false,
      questionIndex: 0,
      shuffledQuestions: [],
      foods: []
    };

    function showToast(msg) {
      const toast = document.getElementById('toastAlert');
      if (toast) {
        toast.innerText = msg;
        toast.classList.remove('hidden');
        setTimeout(() => toast.classList.add('hidden'), 3500);
      }
    }

    // Colors Palette
    const COLORS = [
      "#ef4444", "#f97316", "#f59e0b", "#10b981", 
      "#06b6d4", "#3b82f6", "#8b5cf6", "#ec4899", 
      "#84cc16", "#14b8a6", "#a855f7", "#f43f5e"
    ];

    // Initialize UI Color Picker
    const colorPickerContainer = document.getElementById('colorPickerContainer');
    if (colorPickerContainer) {
      colorPickerContainer.innerHTML = '';
      COLORS.forEach(c => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `w-9 h-9 rounded-full border-2 transition-transform duration-150 transform hover:scale-110 flex items-center justify-center ${state.color === c ? 'border-white scale-110' : 'border-transparent'}`;
        btn.style.backgroundColor = c;
        btn.onclick = () => {
          state.color = c;
          document.querySelectorAll('#colorPickerContainer button').forEach(b => b.classList.replace('border-white', 'border-transparent'));
          btn.classList.replace('border-transparent', 'border-white');
        };
        colorPickerContainer.appendChild(btn);
      });
    }

    // Expose control functions to Window
    window.joinGameAsStudent = function() {
      const nameInput = document.getElementById('inputStudentName');
      const name = nameInput ? nameInput.value.trim() : '';

      if (!name) {
        showToast("Mohon masukkan Nama atau Nomor Absen Murid!");
        return;
      }

      state.studentName = name;
      mySnake.name = name;
      mySnake.color = state.color;

      shuffleQuestions();

      document.getElementById('lobbyScreen').classList.add('hidden');
      document.getElementById('gameHUD').classList.remove('hidden');
      
      document.getElementById('hudPlayerName').innerText = state.studentName;
      document.getElementById('hudWormPreview').style.backgroundColor = state.color;

      state.gameRunning = true;
      state.isUserPaused = false;
      state.isPausedForQuiz = false;
    };

    window.togglePauseGame = function() {
      if (!state.gameRunning || state.isPausedForQuiz) return;
      state.isUserPaused = !state.isUserPaused;

      const pauseModal = document.getElementById('pauseModal');
      if (state.isUserPaused) {
        pauseModal.classList.remove('hidden');
      } else {
        pauseModal.classList.add('hidden');
      }
    };

    window.resumeGameFromPause = function() {
      state.isUserPaused = false;
      document.getElementById('pauseModal').classList.add('hidden');
    };

    window.restartGame = function() {
      state.score = 0;
      state.correctCount = 0;
      state.wrongCount = 0;
      state.isUserPaused = false;
      state.isPausedForQuiz = false;

      document.getElementById('hudScore').innerText = '0';
      document.getElementById('statCorrect').innerText = '0';
      document.getElementById('statWrong').innerText = '0';
      document.getElementById('pauseModal').classList.add('hidden');

      mySnake.x = WORLD_SIZE / 2;
      mySnake.y = WORLD_SIZE / 2;
      mySnake.segments = [];
      initFoods();
    };

    // Keyboard Pause Shortcuts
    window.addEventListener('keydown', (e) => {
      if (e.code === 'Space' || e.key === 'p' || e.key === 'P') {
        if (state.gameRunning && !state.isPausedForQuiz) {
          window.togglePauseGame();
        }
      }
    });

    // 50 BANK SOAL INFORMATIKA SMP (PAK OVAN)

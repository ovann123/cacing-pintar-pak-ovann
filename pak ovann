    // Audio Synthesizer
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    function playSound(type) {
      try {
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);

        if (type === 'eat') {
          osc.frequency.setValueAtTime(300, audioCtx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(600, audioCtx.currentTime + 0.1);
          gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.1);
          osc.start();
          osc.stop(audioCtx.currentTime + 0.1);
        } else if (type === 'correct') {
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(523.25, audioCtx.currentTime);
          osc.frequency.setValueAtTime(659.25, audioCtx.currentTime + 0.1);
          gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
          osc.start();
          osc.stop(audioCtx.currentTime + 0.3);
        } else if (type === 'wrong') {
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(220, audioCtx.currentTime);
          osc.frequency.setValueAtTime(150, audioCtx.currentTime + 0.15);
          gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
          osc.start();
          osc.stop(audioCtx.currentTime + 0.3);
        }
      } catch(e) {}
    }

    // CANVAS & SNAKE ENGINE
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const WORLD_SIZE = 2400;

    let mySnake = {
      name: '',
      x: WORLD_SIZE / 2,
      y: WORLD_SIZE / 2,
      angle: 0,
      speed: 3.5,
      radius: 14,
      color: state.color,
      segments: []
    };

    let keys = {};
    let joystickVector = { x: 0, y: 0 };

    window.addEventListener('keydown', e => keys[e.key] = true);
    window.addEventListener('keyup', e => keys[e.key] = false);

    // Touch Joystick Setup
    const joystickZone = document.getElementById('joystickZone');
    const joystickKnob = document.getElementById('joystickKnob');
    let joystickActive = false;
    let joystickCenter = { x: 0, y: 0 };

    if (joystickZone && joystickKnob) {
      joystickZone.addEventListener('touchstart', e => {
        joystickActive = true;
        const rect = joystickZone.getBoundingClientRect();
        joystickCenter = { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
        handleTouch(e.touches[0]);
      }, { passive: false });

      joystickZone.addEventListener('touchmove', e => {
        if (joystickActive) handleTouch(e.touches[0]);
      }, { passive: false });

      joystickZone.addEventListener('touchend', () => {
        joystickActive = false;
        joystickKnob.style.transform = `translate(0px, 0px)`;
        joystickVector = { x: 0, y: 0 };
      });
    }

    function handleTouch(touch) {
      const dx = touch.clientX - joystickCenter.x;
      const dy = touch.clientY - joystickCenter.y;
      const dist = Math.hypot(dx, dy);
      const maxRadius = 35;
      const angle = Math.atan2(dy, dx);
      const clampedDist = Math.min(dist, maxRadius);

      const knobX = Math.cos(angle) * clampedDist;
      const knobY = Math.sin(angle) * clampedDist;
      joystickKnob.style.transform = `translate(${knobX}px, ${knobY}px)`;
      joystickVector = { x: Math.cos(angle), y: Math.sin(angle) };
    }

    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    function initFoods() {
      state.foods = [];
      for (let i = 0; i < 160; i++) {
        state.foods.push({
          id: i,
          x: Math.random() * WORLD_SIZE,
          y: Math.random() * WORLD_SIZE,
          color: COLORS[Math.floor(Math.random() * COLORS.length)],
          radius: 6 + Math.random() * 3
        });
      }
    }
    initFoods();

    function shuffleQuestions() {
      state.shuffledQuestions = [...QUESTION_BANK].sort(() => Math.random() - 0.5);
      state.questionIndex = 0;
    }

    // Main Game Loop
    let lastTime = performance.now();
    function gameLoop(now) {
      const dt = (now - lastTime) / 1000;
      lastTime = now;

      update(dt);
      render();

      requestAnimationFrame(gameLoop);
    }

    function update(dt) {
      if (!state.gameRunning || state.isUserPaused || state.isPausedForQuiz) return;

      if (joystickVector.x !== 0 || joystickVector.y !== 0) {
        mySnake.angle = Math.atan2(joystickVector.y, joystickVector.x);
      } else if (keys['ArrowLeft'] || keys['a'] || keys['A']) {
        mySnake.angle -= 3.5 * dt;
      } else if (keys['ArrowRight'] || keys['d'] || keys['D']) {
        mySnake.angle += 3.5 * dt;
      }

      mySnake.x += Math.cos(mySnake.angle) * mySnake.speed;
      mySnake.y += Math.sin(mySnake.angle) * mySnake.speed;

      // Wrap Arena Edge smoothly
      if (mySnake.x < 0) mySnake.x = WORLD_SIZE;
      if (mySnake.x > WORLD_SIZE) mySnake.x = 0;
      if (mySnake.y < 0) mySnake.y = WORLD_SIZE;
      if (mySnake.y > WORLD_SIZE) mySnake.y = 0;

      mySnake.segments.unshift({ x: mySnake.x, y: mySnake.y });
      const targetLength = Math.floor(15 + state.score / 10);
      while (mySnake.segments.length > targetLength) {
        mySnake.segments.pop();
      }

      // Eating Food Check
      state.foods.forEach(f => {
        if (state.isPausedForQuiz) return;
        const dist = Math.hypot(mySnake.x - f.x, mySnake.y - f.y);
        if (dist < mySnake.radius + f.radius) {
          f.x = Math.random() * WORLD_SIZE;
          f.y = Math.random() * WORLD_SIZE;
          playSound('eat');
          state.score += 10;
          document.getElementById('hudScore').innerText = state.score;

          // Freeze worm movement and launch Quiz popup
          state.isPausedForQuiz = true;
          triggerInformaticsQuiz();
        }
      });
    }

    function render() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      const cameraX = canvas.width / 2 - mySnake.x;
      const cameraY = canvas.height / 2 - mySnake.y;

      ctx.save();
      ctx.translate(cameraX, cameraY);

      // Arena Grid Background
      ctx.strokeStyle = "rgba(255, 255, 255, 0.04)";
      ctx.lineWidth = 2;
      const gridSize = 100;
      for (let x = 0; x < WORLD_SIZE; x += gridSize) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, WORLD_SIZE);
        ctx.stroke();
      }
      for (let y = 0; y < WORLD_SIZE; y += gridSize) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(WORLD_SIZE, y);
        ctx.stroke();
      }

      // Border Lines
      ctx.strokeStyle = "rgba(56, 189, 248, 0.4)";
      ctx.lineWidth = 8;
      ctx.strokeRect(0, 0, WORLD_SIZE, WORLD_SIZE);

      // Foods
      state.foods.forEach(f => {
        ctx.fillStyle = f.color;
        ctx.beginPath();
        ctx.arc(f.x, f.y, f.radius, 0, Math.PI * 2);
        ctx.fill();
      });

      // Draw Player Worm
      drawWorm(mySnake.x, mySnake.y, mySnake.angle, mySnake.color, mySnake.name, mySnake.segments);

      ctx.restore();
    }

    function drawWorm(hx, hy, angle, color, name, segments) {
      if (segments && segments.length > 0) {
        for (let i = segments.length - 1; i >= 0; i -= 2) {
          const seg = segments[i];
          const segRadius = Math.max(6, 14 - (i * 0.15));
          ctx.fillStyle = color;
          ctx.beginPath();
          ctx.arc(seg.x, seg.y, segRadius, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      ctx.save();
      ctx.translate(hx, hy);
      ctx.rotate(angle);

      ctx.fillStyle = color;
      ctx.shadowColor = '#38bdf8';
      ctx.shadowBlur = 12;
      ctx.beginPath();
      ctx.arc(0, 0, 15, 0, Math.PI * 2);
      ctx.fill();
      ctx.shadowBlur = 0;

      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(6, -6, 4, 0, Math.PI * 2);
      ctx.arc(6, 6, 4, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#0f172a';
      ctx.beginPath();
      ctx.arc(8, -6, 2, 0, Math.PI * 2);
      ctx.arc(8, 6, 2, 0, Math.PI * 2);
      ctx.fill();

      ctx.restore();

      ctx.font = 'bold 12px Inter, sans-serif';
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'center';
      ctx.shadowColor = 'rgba(0,0,0,0.8)';
      ctx.shadowBlur = 4;
      ctx.fillText(name || 'Murid', hx, hy - 22);
      ctx.shadowBlur = 0;
    }

    function triggerInformaticsQuiz() {
      if (state.shuffledQuestions.length === 0) shuffleQuestions();

      const qData = state.shuffledQuestions[state.questionIndex];
      state.questionIndex = (state.questionIndex + 1) % state.shuffledQuestions.length;

      document.getElementById('quizCategory').innerText = qData.cat;
      document.getElementById('quizQuestionText').innerText = qData.q;
      
      const optionsContainer = document.getElementById('quizOptionsContainer');
      optionsContainer.innerHTML = '';
      const feedback = document.getElementById('quizFeedback');
      feedback.classList.add('hidden');

      qData.options.forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.className = "w-full text-left p-3.5 bg-slate-900/80 hover:bg-sky-600/30 border border-slate-700/80 hover:border-sky-500 rounded-xl transition-all font-semibold text-sm text-slate-200 flex items-center justify-between";
        btn.innerHTML = `<span>${String.fromCharCode(65 + idx)}. ${opt}</span> <i class="fa-regular fa-circle text-slate-500"></i>`;
        
        btn.onclick = () => handleAnswerSelect(idx, qData.answer, btn);
        optionsContainer.appendChild(btn);
      });

      document.getElementById('quizModal').classList.remove('hidden');
    }

    function handleAnswerSelect(selectedIdx, correctIdx, btn) {
      const optionsButtons = document.querySelectorAll('#quizOptionsContainer button');
      optionsButtons.forEach(b => b.disabled = true);

      const feedback = document.getElementById('quizFeedback');
      feedback.classList.remove('hidden');

      if (selectedIdx === correctIdx) {
        playSound('correct');
        btn.classList.add('bg-emerald-600/40', 'border-emerald-500', 'text-emerald-200');
        feedback.className = "mt-4 p-3 rounded-xl text-center text-xs font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30";
        feedback.innerText = "✨ JAWABAN BENAR! +100 Poin";

        state.score += 100;
        state.correctCount += 1;
      } else {
        playSound('wrong');
        btn.classList.add('bg-rose-600/40', 'border-rose-500', 'text-rose-200');
        feedback.className = "mt-4 p-3 rounded-xl text-center text-xs font-bold bg-rose-500/20 text-rose-400 border border-rose-500/30";
        feedback.innerText = `❌ SALAH (-20 Poin). Jawaban Tepat: ${String.fromCharCode(65 + correctIdx)}`;

        state.score = Math.max(0, state.score - 20);
        state.wrongCount += 1;
      }

      document.getElementById('hudScore').innerText = state.score;
      document.getElementById('statCorrect').innerText = state.correctCount;
      document.getElementById('statWrong').innerText = state.wrongCount;

      setTimeout(() => {
        document.getElementById('quizModal').classList.add('hidden');
        // Unfreeze worm movement after quiz closes
        state.isPausedForQuiz = false;
      }, 1400);
    }

    requestAnimationFrame(gameLoop);
  </script>
</body>
</html>
